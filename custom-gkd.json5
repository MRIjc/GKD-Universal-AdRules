  "version": 14,
  "author": "MRIjc",
  "description": "保留原有应用规则和3组全局规则，并加入123云盘广告关闭及跳过规则。",
  "updateUrl": "https://raw.githubusercontent.com/MRIjc/GKD-Universal-AdRules/main/custom-gkd.json5",
  "checkUpdateUrl": "https://raw.githubusercontent.com/MRIjc/GKD-Universal-AdRules/main/custom-gkd.version.json5",
  "supportUri": "https://github.com/MRIjc/GKD-Universal-AdRules",
